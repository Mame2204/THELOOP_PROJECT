# --- Dev / test Expo Go ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fallback LAN (start-mobile.ps1 met à jour IP/port). Tunnel = hostUri Metro à l'exécution.
EXPO_PUBLIC_DEV_AUTH_REDIRECT_URL=exp://192.168.1.179:8082/--/auth/callback

# Supabase → Authentication → Redirect URLs : exp://** + theloop://**
# Site URL prod : theloop://auth/callback

# NE PAS définir EXPO_PUBLIC_AUTH_REDIRECT_URL en dev Expo Go (réservé aux builds EAS)

# --- Builds EAS preview/production → eas.json injecte theloop://auth/callback ---
