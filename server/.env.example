# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Origines autorisées (séparées par des virgules)
# Prod : admin web + sites THE LOOP
CORS_ORIGINS=http://localhost:8082,http://localhost:5173,http://localhost:5174,https://admin.theloop-app.com,https://www.theloop-app.com,https://theloop-app.com

# ─── Supabase (service role — JAMAIS dans l'app mobile) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Djomy ─────────────────────────────────────────────────────────────────
# Sandbox (tests) :
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
# Production (compte marchand activé) :
# DJOMY_BASE_URL=https://api.djomy.africa
# DJOMY_PARTNER_API_KEY=…   # header X-PARTNER-API — obligatoire en prod
DJOMY_CLIENT_ID=your-djomy-client-id
DJOMY_CLIENT_SECRET=your-djomy-client-secret

# Retours portail — PROD / PaaS (api.theloop-app.com)
DJOMY_RETURN_URL=https://api.theloop-app.com/payment/success
DJOMY_CANCEL_URL=https://api.theloop-app.com/payment/cancel

# 1 = montants sandbox (≤ 10k GNF). 0 = tarifs prod PASS.
PAYMENT_SANDBOX_AMOUNTS=1

# Tarifs PASS production (GNF) — si PAYMENT_SANDBOX_AMOUNTS=0
PASS_PRICE_MONTHLY_GNF=850000
PASS_PRICE_QUARTERLY_GNF=2400000
PASS_PRICE_ANNUAL_GNF=8500000
PASS_PRICE_LIFETIME_GNF=25000000

# Cron externe — push planifiés (admin_push_campaigns)
# CRON_SECRET=change-me-long-random

# Optionnel — override montants sandbox
# PASS_SANDBOX_PRICE_MONTHLY_GNF=1000
# PASS_SANDBOX_PRICE_QUARTERLY_GNF=2500
# PASS_SANDBOX_PRICE_ANNUAL_GNF=5000
# PASS_SANDBOX_PRICE_LIFETIME_GNF=10000
